 #define GSLWORKSIZE 100000
 
+#ifdef DM_SIDM_D3_HL
+#include "sidm_d3_hl_math.h"
+#ifdef GRAIN_COLLISIONS
+#error "DM_SIDM_D3_HL is a dark-matter two-species kernel and cannot be combined with GRAIN_COLLISIONS"
+#endif
+#if SIDM_D3_H_TYPE == SIDM_D3_L_TYPE
+#error "SIDM_D3_H_TYPE and SIDM_D3_L_TYPE must be distinct"
